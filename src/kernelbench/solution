import torch
import torch.nn as nn
from torch.utils.cpp_extension import load_inline

matrix_mul_source = r"""
#include <torch/extension.h>
#include <cuda_runtime.h>

// Optimized matrix multiplication using shared memory tiling and register blocking
// Implements a hierarchical tiling strategy for cache efficiency

#define TILE_SIZE 32
#define REG_BLOCK_M 8
#define REG_BLOCK_N 8

__global__ void matmul_kernel(
    const float* __restrict__ A,
    const float* __restrict__ B,
    float* __restrict__ C,
    const int N)
{
    // Shared memory for tiles of A and B
    __shared__ float As[TILE_SIZE][TILE_SIZE + 1];  // +1 to avoid bank conflicts
    __shared__ float Bs[TILE_SIZE][TILE_SIZE + 1];
    
    // Block and thread indices
    const int bx = blockIdx.x;
    const int by = blockIdx.y;
    const int tx = threadIdx.x;
    const int ty = threadIdx.y;
    
    // Each thread computes REG_BLOCK_M x REG_BLOCK_N elements
    const int threads_per_tile_m = TILE_SIZE / REG_BLOCK_M;
    const int threads_per_tile_n = TILE_SIZE / REG_BLOCK_N;
    
    const int thread_block_m = ty / threads_per_tile_n;
    const int thread_block_n = ty % threads_per_tile_n;
    const int thread_m = thread_block_m * REG_BLOCK_M;
    const int thread_n = thread_block_n * REG_BLOCK_N;
    
    // Global row and column indices for this thread's output block
    const int row_base = by * TILE_SIZE + thread_m;
    const int col_base = bx * TILE_SIZE + thread_n;
    
    // Register arrays for accumulation
    float acc[REG_BLOCK_M][REG_BLOCK_N];
    #pragma unroll
    for (int i = 0; i < REG_BLOCK_M; ++i) {
        #pragma unroll
        for (int j = 0; j < REG_BLOCK_N; ++j) {
            acc[i][j] = 0.0f;
        }
    }
    
    // Register arrays for loaded data
    float reg_a[REG_BLOCK_M];
    float reg_b[REG_BLOCK_N];
    
    // Loop over tiles
    const int num_tiles = (N + TILE_SIZE - 1) / TILE_SIZE;
    
    for (int tile = 0; tile < num_tiles; ++tile) {
        // Collaborative loading of A tile (each thread loads multiple elements)
        #pragma unroll
        for (int i = 0; i < TILE_SIZE; i += blockDim.y) {
            #pragma unroll
            for (int j = 0; j < TILE_SIZE; j += blockDim.x) {
                int row = by * TILE_SIZE + ty + i;
                int col = tile * TILE_SIZE + tx + j;
                if (ty + i < TILE_SIZE && tx + j < TILE_SIZE) {
                    As[ty + i][tx + j] = (row < N && col < N) ? A[row * N + col] : 0.0f;
                }
            }
        }
        
        // Collaborative loading of B tile
        #pragma unroll
        for (int i = 0; i < TILE_SIZE; i += blockDim.y) {
            #pragma unroll
            for (int j = 0; j < TILE_SIZE; j += blockDim.x) {
                int row = tile * TILE_SIZE + ty + i;
                int col = bx * TILE_SIZE + tx + j;
                if (ty + i < TILE_SIZE && tx + j < TILE_SIZE) {
                    Bs[ty + i][tx + j] = (row < N && col < N) ? B[row * N + col] : 0.0f;
                }
            }
        }
        
        __syncthreads();
        
        // Compute using register blocking
        #pragma unroll
        for (int k = 0; k < TILE_SIZE; ++k) {
            // Load A values into registers
            #pragma unroll
            for (int i = 0; i < REG_BLOCK_M; ++i) {
                reg_a[i] = As[thread_m + i][k];
            }
            
            // Load B values into registers
            #pragma unroll
            for (int j = 0; j < REG_BLOCK_N; ++j) {
                reg_b[j] = Bs[k][thread_n + j];
            }
            
            // Compute outer product and accumulate
            #pragma unroll
            for (int i = 0; i < REG_BLOCK_M; ++i) {
                #pragma unroll
                for (int j = 0; j < REG_BLOCK_N; ++j) {
                    acc[i][j] += reg_a[i] * reg_b[j];
                }
            }
        }
        
        __syncthreads();
    }
    
    // Write results to global memory
    #pragma unroll
    for (int i = 0; i < REG_BLOCK_M; ++i) {
        #pragma unroll
        for (int j = 0; j < REG_BLOCK_N; ++j) {
            int row = row_base + i;
            int col = col_base + j;
            if (row < N && col < N) {
                C[row * N + col] = acc[i][j];
            }
        }
    }
}

torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B) {
    const int N = A.size(0);
    auto C = torch::empty({N, N}, A.options());
    
    // Configure thread block: 32x4 = 128 threads
    // Each thread computes 8x8 output elements
    dim3 threads(32, 4);
    
    // Configure grid
    dim3 blocks((N + TILE_SIZE - 1) / TILE_SIZE, (N + TILE_SIZE - 1) / TILE_SIZE);
    
    matmul_kernel<<<blocks, threads>>>(
        A.data_ptr<float>(),
        B.data_ptr<float>(),
        C.data_ptr<float>(),
        N
    );
    
    return C;
}
"""

cpp_source = """
torch::Tensor matmul_cuda(torch::Tensor A, torch::Tensor B);
"""

# Compile the CUDA kernel
matmul_module = load_inline(
    name='matmul_optimized',
    cpp_sources=cpp_source,
    cuda_sources=matrix_mul_source,
    functions=['matmul_cuda'],
    verbose=False,
    extra_cuda_cflags=['-O3', '--use_fast_math', '-lineinfo']
)

class ModelNew(nn.Module):
    """
    Optimized model using custom CUDA kernel for matrix multiplication.
    
    Optimizations implemented:
    1. Hierarchical tiling (shared memory blocking)
    2. Register blocking (8x8 per thread)
    3. Bank conflict avoidance (padding shared memory)
    4. Coalesced global memory access
    5. Loop unrolling
    6. Fast math operations
    """
    def __init__(self):
        super(ModelNew, self).__init__()
    
    def forward(self, A: torch.Tensor, B: torch.Tensor) -> torch.Tensor:
        """
        Performs optimized matrix multiplication using custom CUDA kernel.
        
        Args:
            A (torch.Tensor): Input matrix A of shape (N, N).
            B (torch.Tensor): Input matrix B of shape (N, N).
        
        Returns:
            torch.Tensor: Output matrix C of shape (N, N).
        """
        assert A.is_cuda and B.is_cuda, "Inputs must be on CUDA device"
        assert A.dtype == torch.float32 and B.dtype == torch.float32, "Only float32 supported"
        assert A.shape == B.shape, "Matrices must have same shape"
        assert len(A.shape) == 2, "Only 2D matrices supported"
        assert A.shape[0] == A.shape[1], "Only square matrices supported"
        assert A.is_contiguous() and B.is_contiguous(), "Inputs must be contiguous"
        
        return matmul_module.matmul_cuda(A, B)